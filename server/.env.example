# MongoDB (shared with the web app)
MONGODB_URI=mongodb://127.0.0.1:27017/moltiply

# Express port
PORT=4000

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Gemini for the AI news digest + rebalancer. Two auth modes:
#   A) Vertex AI via gcloud ADC (no API key) — set these three:
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-gcp-project
# GOOGLE_CLOUD_LOCATION=global
#   B) Google AI Studio API key (aistudio.google.com/apikey):
GEMINI_API_KEY=
AI_MODEL=gemini-2.5-flash

# Public URL of the web app (used in bot messages)
WEB_URL=http://localhost:3000

# Wallet key with UPDATER_ROLE on the PriceOracle (pushes prices on-chain)
ORACLE_UPDATER_KEY=

# Wallet key with MANAGER_ROLE on the vaults (executes AI rebalances on-chain)
REBALANCER_KEY=

# Bearer token protecting the manual /api/tick/* endpoints
ADMIN_TOKEN=
