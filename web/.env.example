# MongoDB (shared with the server)
MONGODB_URI=mongodb://127.0.0.1:27017/moltiply

# Gemini for /api/ai/insight. Two auth modes:
#   A) Vertex AI via gcloud ADC (no API key) — set these three:
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-gcp-project
# GOOGLE_CLOUD_LOCATION=global
#   B) Google AI Studio API key (aistudio.google.com/apikey):
GEMINI_API_KEY=

# Telegram bot username shown on the Labs page (without @)
NEXT_PUBLIC_TELEGRAM_BOT=MoltiplyBot
